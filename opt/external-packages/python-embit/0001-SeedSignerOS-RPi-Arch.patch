From cee28bd83882b4033c814583eda555ab5ad01b6e Mon Sep 17 00:00:00 2001
From: Nick Klockenga <nick@klockenga.net>
Date: Fri, 5 Jul 2024 09:03:05 -0400
Subject: [PATCH] SeedSignerOS RPi Arch

Ship only the ARM prebuilt libsecp256k1, since that is the only one this
image can use.

The upstream version of this patch also trimmed src/embit.egg-info/SOURCES.txt.
That file exists only in a PyPI sdist, not in an archive produced from the git
tree, so the hunk failed to apply and stopped the build. It was redundant in any
case: SOURCES.txt is generated metadata, the packaging restriction below is what
actually decides which files are installed, and post-build.sh removes the
non-ARM libraries from the target regardless.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index fb8fcfe..aa2063c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -33,7 +33,7 @@ dev = [
 where = ["src"]
 
 [tool.setuptools.package-data]
-embit = ["util/prebuilt/*"]
+embit = ["util/prebuilt/libsecp256k1_linux_arm*"]
 
 
 [tool.pytest.ini_options]
